        <mxCell id="life9" value="table:Table" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;size=40;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1730" y="65" width="160" height="1875" />
        </mxCell>
        <mxCell id="msg1" value="Use case: manager chooses VIP priority or C1 food priority. Stage 2; starts with empty restaurant and two free tables. Both fixtures run all 18 turns. Outcome differs in VIP payment turn and satisfaction, not the verdict. Main constructs Restaurant and ConsoleUI, injects Main::createCustomer and stage=2, then calls run()." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="150" width="1480" height="95" />
        </mxCell>
        <mxCell id="msg2" value="Turns 1–3: factory creates C1 Regular on turn 1; registerArrival(C1); seat C1 on turn 1. Both staff Wait otherwise. Each complete turn ends with eating → oldest eligible payment → waiting loss → state and summary. Lifecycle calls for C1/C3 and repeated queries are abbreviated." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="270" width="1480" height="85" />
        </mxCell>
        <mxCell id="msg3" value="turn 4: customerFactory.apply(2) → Main.createCustomer(2)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="480" y="380" />
            <mxPoint as="targetPoint" x="525" y="405" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg4" value="registerArrival(vip) [nonnull, id=2]" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="480" y="465" />
            <mxPoint as="targetPoint" x="670" y="465" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg5" value="registerArrival binds the customer to Restaurant, appends customer history and waitingQueue. C2 arrives with satisfaction=100. Snapshots expose stage=2 and the real VIP label." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="530" width="1480" height="65" />
        </mxCell>
        <mxCell id="msg6" value="alt" style="shape=umlFrame;html=1;fillColor=none;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;tabWidth=55;tabHeight=25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="620" width="1850" height="1190.0" />
        </mxCell>
        <mxCell id="msg7" value="chooseWaiterAction()" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="480" y="680" />
            <mxPoint as="targetPoint" x="290" y="680" />
          </mxGeometry>
