        <mxCell id="msg13" value="seat() [WAITING → SEATED]" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1810" y="1070" />
            <mxPoint as="targetPoint" x="1050" y="1070" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg14" value="On success: Waiter marks task used; Restaurant removes VIP from waitingQueue. Chef Waits. End-of-turn waiting loss makes VIP satisfaction=95. Parameters: orderTurn=5, serveTurn=6, readyToPayTurn=7, paidTurn=8." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="1135" width="1480" height="70" />
        </mxCell>
        <mxCell id="msg15" value="" style="shape=line;html=1;dashed=1;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1230" width="1850" height="1" />
        </mxCell>
        <mxCell id="msg16" value="turn 4: order 1; Chef selects order 1" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="100" y="1290" />
            <mxPoint as="targetPoint" x="290" y="1290" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg17" value="Controller resolves C1, calls C1.chooseItem(menu) and applyDiscount(1500), then Waiter.takeOrder(C1, Burger, 1500, 4). Chef.prepare(O1, 4) makes O1 READY. C1 is never served in this fixture; its order later cancels on departure." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="1355" width="1480" height="80" />
        </mxCell>
        <mxCell id="msg18" value="turn 5: seatCustomer(vip, 5)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
