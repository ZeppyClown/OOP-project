        <mxCell id="msg19" value="Salad needs one unit: Order → READY; readyTurn=orderTurn. Chef marks its task used only on success. Waiter already acted, and canBeServedAt requires readyTurn &amp;lt; turn." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
