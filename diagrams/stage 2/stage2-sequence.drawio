        <mxCell id="msg11" value="seat(vip, freeTable, 4)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
