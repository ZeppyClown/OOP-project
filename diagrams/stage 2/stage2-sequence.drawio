          </mxGeometry>
        </mxCell>
        <mxCell id="msg19" value="seat(vip, freeTable, 5)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="1525" />
            <mxPoint as="targetPoint" x="860" y="1525" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg20" value="seat(vip)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="860" y="1590" />
            <mxPoint as="targetPoint" x="1810" y="1590" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg21" value="seat() [WAITING → SEATED]" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1810" y="1655" />
            <mxPoint as="targetPoint" x="1050" y="1655" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg22" value="The same queue/capacity rules apply. VIP loses 5 at the end of turns 4 and 5. Parameters: orderTurn=6, serveTurn=7, readyToPayTurn=8, paidTurn=9. Continue with the shared flow on page 2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="1720" width="1480" height="70" />
