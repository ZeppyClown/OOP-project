        </mxCell>
        <mxCell id="msg9" value="WaiterAction.seat(2)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
