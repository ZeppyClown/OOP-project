          </mxGeometry>
        </mxCell>
        <mxCell id="msg10" value="seatCustomer(vip, 4)" style="html=1;endArrow=block;endFill=1;dashed=0;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="480" y="875" />
