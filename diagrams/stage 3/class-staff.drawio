        <mxCell id="note0" value="&lt;b&gt;Staff&lt;/b&gt;&lt;br&gt;Capacity is per staff instance. Failed actions preserve&lt;br/&gt;taskTurn. A successful Host task leaves Waiter capacity&lt;br/&gt;available and vice versa." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2081" width="560" height="150" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;Restaurant&lt;/b&gt;&lt;br&gt;Every staff action from the controller goes through&lt;br/&gt;these methods. They reject foreign customers/orders;&lt;br/&gt;seating removes a queue entry only on success. Four-&lt;br/&gt;argument constructor creates a Host." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="2081" width="560" height="150" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Waiter&lt;/b&gt;&lt;br&gt;Restaurant supplies its own customer, menu choice and&lt;br/&gt;quote. Waiter checks local state, timing and capacity,&lt;br/&gt;not the global turn phase." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="2081" width="560" height="150" />
        </mxCell>
