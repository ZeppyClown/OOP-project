        <mxCell id="note0" value="&lt;b&gt;ComboMeal&lt;/b&gt;&lt;br&gt;Two actual references, immutable list, first and second may alias. Price is 90 percent of summed cents; preparation is summed units. Null and overflow rejected." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1960" width="560" height="150" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;MenuItem&lt;/b&gt;&lt;br&gt;Private final values, final getters. A ComboMeal is an ordinary MenuItem for Order and Chef." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1960" width="560" height="150" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Menu&lt;/b&gt;&lt;br&gt;Default includes Salad + Burger combo at 2160 cents / 2 units. Menu(false) is the explicit inherited three-item regression fixture." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="1960" width="560" height="150" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;PricingPolicy&lt;/b&gt;&lt;br&gt;Controller selects by Happy Hour timing, never customer subtype. Customer discount first; Happy Hour then rounds to nearest cent. VIP combo: 2160 to 1944 to 1555." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2140" width="560" height="150" />
        </mxCell>
        <mxCell id="note4" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;Final billCents freezes the policy quote at placement, including payment after expiry." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="2140" width="560" height="150" />
        </mxCell>
