        </mxCell>
        <mxCell id="note0" value="&lt;b&gt;Restaurant&lt;/b&gt;&lt;br&gt;Aggregate root. The controller reaches Host, Waiter,&lt;br/&gt;Chef and Cashier only through these methods, so&lt;br/&gt;queue/table/ownership checks stay here. Six arrivals is&lt;br/&gt;a controller rule." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="5858" width="560" height="150" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;Encapsulation: private lifecycle state, package-private&lt;br/&gt;guarded transitions. Polymorphism: patience, discount&lt;br/&gt;and menu preference dispatch through Customer." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="5858" width="560" height="150" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;ComboMeal&lt;/b&gt;&lt;br&gt;Composition of two actual immutable component&lt;br/&gt;references. Shared aggregation: first and second may&lt;br/&gt;refer to the same MenuItem." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="5858" width="560" height="150" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;Final billCents locks the quote at placement. Recovery&lt;br/&gt;and later policy changes do not reprice it." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2690" y="5858" width="560" height="150" />
        </mxCell>
      </root>
