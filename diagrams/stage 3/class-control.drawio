        <mxCell id="note0" value="&lt;b&gt;HappyHour&lt;/b&gt;&lt;br&gt;activate returns null on success or a refusal reason.&lt;br/&gt;Turn must be 1..18; reuse rejected. Active at&lt;br/&gt;activation and activation+1. Remaining is 2,1,0. Turn&lt;br/&gt;18 adds no extra game turn." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="3395" width="560" height="150" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;GameIO&lt;/b&gt;&lt;br&gt;Default activation false, Host 0, display no-op support&lt;br/&gt;older test doubles. Real ConsoleUI implements the new&lt;br/&gt;choices. Snapshots contain copied immutable lists." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="3395" width="560" height="150" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;GameView&lt;/b&gt;&lt;br&gt;Nested records: CustomerLine, TableLine, OrderLine,&lt;br/&gt;TurnState, TurnSummary, TargetLine, FinalReport. No&lt;br/&gt;mutable domain objects cross this boundary." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="3395" width="560" height="150" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;GameController&lt;/b&gt;&lt;br&gt;Stage is display metadata 1..3. Stage 3 phases always&lt;br/&gt;run. Activation is offered only while unused; recovery&lt;br/&gt;happens before display and Host. Invalid actions retry&lt;br/&gt;before consuming a task. Picks the pricing policy by&lt;br/&gt;turn and passes it to Restaurant.takeOrder." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="3575" width="560" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>