        <mxCell id="note0" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;Final recovery rejects negative amounts and uses long&lt;br/&gt;addition capped at 100. Eligible states: WAITING,&lt;br/&gt;SEATED and WAITING_FOR_FOOD, including&lt;br/&gt;PLACED/PREPARING/READY orders. No public lifecycle&lt;br/&gt;setters." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2736" width="560" height="150" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;VIPCustomer&lt;/b&gt;&lt;br&gt;Waiting loss 5. 90 percent quote. Inherits menu-size-&lt;br/&gt;based ID choice." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="2736" width="560" height="150" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;CriticCustomer&lt;/b&gt;&lt;br&gt;Waiting loss 12. Always chooses actual Pasta by name.&lt;br/&gt;Full price inherited." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="2736" width="560" height="150" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;RegularCustomer&lt;/b&gt;&lt;br&gt;Waiting loss 8. Default menu ID rotation is Burger,&lt;br/&gt;Salad, Pasta, combo." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2916" width="560" height="150" />
        </mxCell>
        <mxCell id="note4" value="&lt;b&gt;Restaurant&lt;/b&gt;&lt;br&gt;Recovery delegates to registered arrivals. Seat/payment&lt;br/&gt;wrappers couple successful transitions with queue&lt;br/&gt;removal/table release; a refused release after payment&lt;br/&gt;or departure throws IllegalStateException. Revenue and&lt;br/&gt;average use paid customers only." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="2916" width="560" height="150" />
        </mxCell>
        <mxCell id="note5" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;billCents is final. READY must predate serving. Eating&lt;br/&gt;and payment each require a later turn. Unserved&lt;br/&gt;departure cancels the order." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=12;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1820" y="2916" width="560" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
