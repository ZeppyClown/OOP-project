tack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=12;fontFamily=Helvetica;startSize=26;" vertex="1" parent="1"><mxGeometry x="2300" y="3700" width="520" height="150" as="geometry"/></mxCell><mxCell id="WR_a0" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="WR"><mxGeometry y="26" width="520" height="20" as="geometry"/></mxCell><mxCell id="WR_d" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="WR"><mxGeometry y="46" width="520" height="8" as="geometry"/></mxCell><mxCell id="WR_o0" value="+ Waiter()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="WR"><mxGeometry y="54" width="520" height="20" as="geometry"/></mxCell><mxCell id="WR_o1" value="~ seat(customer : Customer, table : Table, turn : int) : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="WR"><mxGeometry y="74" width="520" height="20" as="geometry"/></mxCell><mxCell id="WR_o2" value="+ serve(customer : Customer, turn : int) : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="WR"><mxGeometry y="94" width="520" height="20" as="geometry"/></mxCell><mxCell id="WR_o3" value="+ takeOrder(customer : Customer, item : MenuItem, billCents : int, turn : int) : String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="WR"><mxGeometry y="114" width="520" height="36" as="geometry"/></mxCell><mxCell id="N_GV" value="Nested public static records. Private final components and public accessors shown.&lt;br&gt;Each has a public canonical constructor with the listed components in declaration order.&lt;br&gt;Generated equals/hashCode/toString are omitted. TurnState and FinalReport copy their lists." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2700" y="1100" width="420" height="92" as="geometry"/></mxCell><mxCell id="NL_GV" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_GV" target="GV"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_IO" value="Only chooseWaiterAction, chooseChefOrder and showInvalidAction are abstract.&lt;br&gt;The five display callbacks have default no-op implementations." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1640" y="400" width="380" height="73" as="geometry"/></mxCell><mxCell id="NL_IO" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_IO" target="IO"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_CU" value="Before registration: zero restaurants. Successful registration binds exactly one permanently.&lt;br&gt;Guarded lifecycle methods return null on success or an explained refusal.&lt;br&gt;Serving, eating and payment require earlier-turn timestamps." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="4100" width="560" height="77" as="geometry"/></mxCell><mxCell id="NL_CU" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_CU" target="CU"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_RE" value="Two internally created tables. External menu/staff references may be shared.&lt;br&gt;registerArrival has no six-customer cap; GameController schedules six across 18 turns.&lt;br&gt;seatCustomer removes queue membership; collectPayment releases the table.&lt;br&gt;Revenue and satisfaction statistics include only paid customers." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1900" y="3200" width="440" height="111" as="geometry"/></mxCell><mxCell id="NL_RE" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_RE" target="RE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_WR" value="seat is package-private; Restaurant owns coupled queue bookkeeping.&lt;br&gt;Public takeOrder and serve remain the controller's role operations." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2300" y="3920" width="440" height="58" as="geometry"/></mxCell><mxCell id="NL_WR" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_WR" target="WR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_GC" value="Trusted coordinator supplies the correct role, owner, item, quote and phase.&lt;br&gt;Public role APIs do not enforce every restaurant policy for arbitrary callers." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="1500" width="440" height="73" as="geometry"/></mxCell><mxCell id="NL_GC" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_GC" target="GC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_CA" value="collect is package-private; Restaurant owns coupled table release." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3300" y="3850" width="340" height="54" as="geometry"/></mxCell><mxCell id="NL_CA" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_CA" target="CA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_ST" value="Capacity is consumed only after a successful validated task." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2960" y="3200" width="360" height="54" as="geometry"/></mxCell><mxCell id="NL_ST" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_ST" target="ST"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="N_WA" value="Nested Type enum; validated public canonical constructor.&lt;br&gt;WAIT requires target 0; other actions require a positive customer/order ID.&lt;br&gt;Generated equals/hashCode/toString are omitted." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="1400" width="520" height="77" as="geometry"/></mxCell><mxCell id="NL_WA" value="" style="endArrow=none;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="N_WA" target="WA"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E1" value="creates and runs" style="edgeSty