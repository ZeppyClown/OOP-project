        <mxCell id="capacity" value="Inheritance reuses the availability guard; each role instance owns its own task timestamp. Refusals preserve capacity because markTaskUsed() is called only after success. Main injects Waiter/Chef/Cashier; Restaurant creates a default Host unless one is supplied." style="shape=note;html=1;whiteSpace=wrap;align=left;spacing=10;fillColor=#fffbe7;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1">
